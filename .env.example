TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Сервер MAX. Не используйте префикс VITE_: эти значения не должны попасть в браузерную сборку.
# Токен из настроек бота. В Bot API передаётся заголовком Authorization, не в URL.
MAX_BOT_TOKEN=
# Секрет подписки webhook: 5–256 символов A–Z, a–z, 0–9, _ и -.
# MAX присылает его в заголовке X-Max-Bot-Api-Secret.
MAX_WEBHOOK_SECRET=
# Числовые user_id модераторов через запятую. Пустое или неверное значение запрещает публикацию.
MAX_REVIEW_MODERATOR_IDS=
# Числовые chat_id разрешённых групп через запятую. Пустое или неверное значение не принимает ни одну группу.
MAX_ALLOWED_CHAT_IDS=
# PostgreSQL. Без этой переменной приём и выдача отзывов в production не работают.
DATABASE_URL=
# Vercel Blob: постоянные URL фото/видео отзывов. Без токена медиа на сайт не копируется.
BLOB_READ_WRITE_TOKEN=
# YouTube Data API v3 (только сервер): проверка роликов вебинаров (существует, публичный, можно встраивать).
# Без ключа импорт работает, статус «не проверено». Ключ ограничьте только YouTube Data API v3.
YOUTUBE_API_KEY=
