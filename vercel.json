{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/max/webhook.js": {
      "maxDuration": 30
    },
    "api/reviews.js": {
      "maxDuration": 10
    },
    "api/webinars.js": {
      "maxDuration": 10
    },
    "api/admin/reviews.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/admin-reviews",
      "destination": "/admin-reviews.html"
    },
    {
      "source": "/api/admin/reviews/:id",
      "destination": "/api/admin/reviews"
    },
    {
      "source": "/review-media/:path*",
      "destination": "https://nixktcrzq4krmovs.public.blob.vercel-storage.com/reviews/:path*"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/admin-reviews",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/admin-reviews.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    }
  ]
}
