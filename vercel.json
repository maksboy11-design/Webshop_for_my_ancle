{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/max/webhook.js": {
      "maxDuration": 30
    },
    "api/reviews.js": {
      "maxDuration": 10
    },
    "api/webinars.js": {
      "maxDuration": 10
    },
    "api/admin/reviews.js": {
      "maxDuration": 10
    },
    "api/products.js": {
      "maxDuration": 10
    },
    "api/admin/products.js": {
      "maxDuration": 30,
      "memory": 1024
    },
    "api/admin/webinars.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/admin-reviews",
      "destination": "/admin-reviews.html"
    },
    {
      "source": "/api/admin/reviews/:id",
      "destination": "/api/admin/reviews"
    },
    {
      "source": "/api/admin/products/:id",
      "destination": "/api/admin/products"
    },
    {
      "source": "/api/admin/webinars/:id",
      "destination": "/api/admin/webinars"
    },
    {
      "source": "/review-media/:path*",
      "destination": "https://nixktcrzq4krmovs.public.blob.vercel-storage.com/reviews/:path*"
    },
    {
      "source": "/product-media/:path*",
      "destination": "https://nixktcrzq4krmovs.public.blob.vercel-storage.com/products/:path*"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/admin-reviews",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/admin-reviews.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/hero/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/brand/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/textures/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/products/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
